# =================================================================
# OMNI-CHECK: Orchestrated Multi-Agent Intelligence & Kernel
# Environment Configuration Template (.env.example)
# =================================================================

# Server Port
PORT=5000

# MongoDB Connection URI (MERN Stack)
# If left blank, the system automatically runs in Resilient Local Storage mode.
MONGODB_URI=mongodb://localhost:27017/omni_check

# Optional Redis Cache & Message Broker
# If left blank, queue & caching runs in local in-memory event-driven mode.
REDIS_URL=redis://localhost:6379

# Optional Python AI Engine Microservice URL
# If left blank or not running, the Node server automatically runs its built-in JS engine.
AI_ENGINE_URL=http://localhost:8000

# Optional Cloudinary Cloud Storage (for reports & document uploads)
# If left blank, the system automatically saves to local /reports and /uploads with high-speed static serving.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API Key (for policy compilation, embeddings & question generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Keys (for ultra-low-latency Llama 3.3 70B / 8B inference & phonetic interceptor)
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Credentials (OPTIONAL)
# You DO NOT need Supabase to run OMNI-CHECK!
# If left blank, the server automatically uses MongoDB and local JSON persistence (data/local_db.json).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional OpenAI Fallback
OPENAI_API_KEY=

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173
