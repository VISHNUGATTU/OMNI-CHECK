# =================================================================
# OMNI-CHECK: Orchestrated Multi-Agent Intelligence & Kernel
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure your secret credentials.
# =================================================================

# Server Port
PORT=5000

# MongoDB Connection URI (MERN Stack)
# If left blank or MongoDB is unavailable, the system automatically falls back to Local JSON persistence.
MONGODB_URI=mongodb://localhost:27017/omni_check

# Google Gemini API Key (for adaptive question generation & policy compilation)
# Supports Gemini 1.5, 2.0, 2.5, 3.x Flash/Pro
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Keys (for ultra-low-latency Llama 3.3 70B & 8B inference & phonetic interceptor)
# Supports multi-key rotation to bypass rate limits
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=

# Supabase Credentials (optional - for cloud vector / file storage)
SUPABASE_URL=
SUPABASE_KEY=

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

